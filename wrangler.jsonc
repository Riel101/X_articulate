{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "x-content-intelligence-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": { "OPENAI_MODEL": "gpt-4.1-mini", "DAILY_TOOL_LIMIT": "100" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "x-content-bank",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    { "binding": "RESEARCH_CACHE", "id": "00000000000000000000000000000000" },
  ],
}
