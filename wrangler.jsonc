{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "x-content-intelligence-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": { "OPENAI_MODEL": "gpt-4.1-mini", "DAILY_TOOL_LIMIT": "100" },
  "d1_databases": [
    {
      "binding": "x_content_bank",
      "database_name": "x-content-bank",
      "database_id": "9ce89efa-aba7-43e9-9230-bcb7c8b5faf0"
    }
  ],
  "kv_namespaces": [
    { "binding": "RESEARCH_CACHE", "id": "501cc3bf110147228cea8a2171bc9928" },
  ],
}
